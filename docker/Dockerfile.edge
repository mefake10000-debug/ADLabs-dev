FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    # Prefer baked openai-clip (requirements-edge.txt). Never let Ultralytics
    # retry `pip install git+CLIP` at runtime (no git in image; kills FPS).
    YOLO_AUTOINSTALL=false \
    YOLO_CONFIG_DIR=/tmp/Ultralytics

# Install runtime dependencies for OpenCV and video decoding
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# PyTorch first, in its own cached layer, from the CPU-only wheel index.
# The default PyPI build for Linux bundles ~4GB of CUDA libraries (nvidia-*, triton) that Docker Desktop
# and the Mac mini target cannot use. For an NVIDIA GPU host, build with e.g.
#   TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130 docker compose build edge-analyzer
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir torch torchvision --index-url ${TORCH_INDEX_URL}

# Install the remaining requirements without asking PyPI to replace the CPU-only
# torch/torchvision wheels installed above with default Linux (CUDA-enabled) wheels.
COPY requirements-edge.txt .
RUN sed -E '/^(torch|torchvision)==/d' requirements-edge.txt > /tmp/requirements-edge-docker.txt \
    && pip install --no-cache-dir -r /tmp/requirements-edge-docker.txt

# Copy source code and default configs
COPY configs/ ./configs/
COPY src/ ./src/
COPY scripts/ ./scripts/

# Create data directories
RUN mkdir -p /app/data/sample_videos /app/data/storage /app/models

# The default container is a small control plane. It does not import the CV
# pipeline or load weights; the supervisor starts src.main only after an
# authenticated, explicit Start request.
CMD ["python", "-m", "src.runtime.supervisor"]
