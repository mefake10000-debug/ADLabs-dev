# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/

# Databases and runtime data
data/storage/*.db
data/storage/*.sqlite3
data/storage/frames/*
!data/storage/frames/.gitkeep
!data/storage/.gitkeep

# Model weights
models/*.pt
models/*.onnx
models/*.engine
!models/.gitkeep

# IDE and OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
*.log

# Ad-hoc manual-verification screen recordings -- useful for a single review pass, not worth
# keeping in history (tens of MB each). Real benchmark/test clips in data/sample_videos/ are
# unaffected; this only matches the default screen-recorder naming pattern.
data/sample_videos/Screen Recording*.mp4

# Local ID-switch reports (scripts/detect_id_switches.py): snapshots of real CCTV frames
data/storage/id_switch_runs/

# Rendered floor heatmaps (real CCTV frames), written by the edge
data/storage/heatmaps/

# Model benchmark output (scripts/benchmark_models.sh) and exported model formats
data/storage/model_bench/
models/*_openvino_model/

# Externally sourced real CCTV (identifiable people) -- local testing only, never committed
data/sample_videos/garage/

# Garage footage evaluation output (real CCTV frames)
data/storage/garage_eval/

# Local backup of the camera config while testing other footage
configs/*.bak
